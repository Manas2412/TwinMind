# Caddy auto-issues + auto-renews Let's Encrypt certs for {$APP_DOMAIN}.
# All non-API traffic is reverse-proxied to the Next.js container on :3000.

{$APP_DOMAIN} {
    encode zstd gzip

    # Long-lived browser caching for hashed Next.js assets.
    @next_static path /_next/static/*
    header @next_static Cache-Control "public, max-age=31536000, immutable"

    # Streaming SSE for /api/chat — disable buffering on the proxy.
    @sse path /api/chat
    reverse_proxy @sse app:3000 {
        flush_interval -1
    }

    reverse_proxy app:3000

    # Auto-HTTPS is enabled implicitly by the named site address above.
    # No `tls <email>` line — an empty ACME_EMAIL would expand to `tls `
    # and crash the parser. Certs still issue (as an anonymous ACME
    # account); if you want expiry emails, add `email {$ACME_EMAIL}` to
    # a global options block once ACME_EMAIL is guaranteed non-empty.

    log {
        output stdout
        format console
        level  INFO
    }
}
